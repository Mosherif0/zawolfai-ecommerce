# OCR + warehouse configuration
# Copy this file to .env and fill in real values.

# --- Warehouse backend ---
# Leave DB_HOST unset to use SQLite (output/inventory.db).
# Set it to switch to PostgreSQL. The warehouse schema (suppliers,
# categories, products, receipts, receipt_items, stock_movements) is applied
# automatically on the first connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zawolf_ocr
DB_USER=postgres
DB_PASSWORD=your_password_here

# Where the SQLite file lives when DB_HOST is unset.
SQLITE_PATH=output/inventory.db

# --- OCR engine ---
# English is the default and fully supported. For Arabic set OCR_LANGUAGE=ar,
# which also runs the English model because Egyptian receipts mix Latin brand
# names with Arabic labels.
OCR_LANGUAGE=en

# Force a specific EasyOCR model list, overriding OCR_LANGUAGE.
# OCR_LANGUAGES=en,ar

# Detections below this confidence are discarded (0-1).
OCR_MIN_CONFIDENCE=0.30