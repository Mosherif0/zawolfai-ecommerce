GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: comma-separated fallback models
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash

# Optional: per-request timeout in milliseconds
GEMINI_TIMEOUT_MS=30000

# Real product catalog (optional - has sensible defaults).
# CATALOG_PATH=/path/to/clean_catalog.csv
# CATALOG_IMAGES_DIR=/path/to/images
