# Copy this file to .env for local development. Never commit .env.
ZAWOLF_WORKSPACE=D:\zawolf-project

# Optional: enables the Gemini-backed chatbot path.
GEMINI_API_KEY=

# Optional PostgreSQL warehouse settings. Leave DB_HOST empty to use SQLite.
DB_HOST=
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=

OCR_LANGUAGE=en
OCR_MIN_CONFIDENCE=0.30
RECEIPT_ACCEPT_THRESHOLD=0.55
