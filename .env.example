# ---------------------------------------------------------------------------
# Zawolf AI — local environment template
#
# Copy this file to `.env` and fill in what you need:
#     copy .env.example .env
#
# The backend works WITHOUT this file. Everything here is optional:
#   - no GEMINI_API_KEY -> the chatbot still answers from the product catalog,
#     it just loses the free-form conversational replies.
#   - no DB_HOST         -> the OCR warehouse uses SQLite (output/inventory.db).
#
# NEVER commit the real `.env`. It is already in .gitignore.
# ---------------------------------------------------------------------------

# --- Workspace -------------------------------------------------------------
# Auto-detected from this file's location. Only set it if you keep the data
# folders somewhere else.
# ZAWOLF_WORKSPACE=D:\path\to\zawolfai-ecommerce

# --- Chatbot (optional) ----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# With a key the chatbot gets full AI replies. Without it, catalog-only answers.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
# GEMINI_TIMEOUT_MS=30000

# --- OCR warehouse (optional) ----------------------------------------------
# Leave DB_HOST empty to use SQLite. Set it to use PostgreSQL instead.
DB_HOST=
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=

# --- OCR engine ------------------------------------------------------------
# en = English only. ar = Arabic + English (Egyptian receipts mix both).
OCR_LANGUAGE=en
OCR_MIN_CONFIDENCE=0.30
RECEIPT_ACCEPT_THRESHOLD=0.55
